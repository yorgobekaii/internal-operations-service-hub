# Copy to .env for local development:
#   copy .env.example .env        (Windows PowerShell: Copy-Item .env.example .env)
#   cp .env.example .env          (macOS / Linux)
#
# Development database (SQLite file resolved by Prisma relative to prisma/schema.prisma).
DATABASE_URL="file:./dev.db"

# --- Week 4 AI triage (Groq) ---
# The backend loads THIS file (apps/backend/.env) automatically on boot —
# yes, putting the values here is the right procedure. No export needed.
# Format is KEY=value (quotes optional, dotenv strips them). Replace the
# placeholders with real values, then RESTART the backend.
# AI_PROVIDER: mock (default, deterministic, no key) | groq (real LLM via Groq API).
AI_PROVIDER="mock"
# Groq API key — REQUIRED only when AI_PROVIDER=groq. Never commit a real key.
# Get one at https://console.groq.com/keys (starts with gsk_). Example:
#   GROQ_API_KEY="gsk_abc123..."
# A placeholder like "value" will NOT work — the API returns 502 for it.
GROQ_API_KEY=""
# Optional Groq model override (OpenAI-compatible chat completions).
# Must be a real, CURRENT model id, e.g. "openai/gpt-oss-120b". A placeholder
# like "value" will NOT work (Groq answers 404 → backend returns 502).
# WARNING: llama-3.3-70b-versatile and llama-3.1-8b-instant were decommissioned
# by Groq in Aug 2026 — they now return 404. Use openai/gpt-oss-120b (or
# openai/gpt-oss-20b / meta-llama/llama-4-maverick-17b-128e-instruct).
GROQ_MODEL="openai/gpt-oss-120b"
# Shell exports (if set) override this file, so prefer editing here and
# do NOT export AI_PROVIDER=groq globally — it would also flip your tests
# to Groq. Tests now force mock regardless, but keep shells clean anyway.

# Isolated E2E test database — NEVER point this at dev.db.
# The e2e harness forces DATABASE_URL=file:./test.db programmatically
# (see test/setup-e2e.ts + test/test-database.ts), so manual export is only
# needed if you run prisma CLI against the test DB yourself:
#   DATABASE_URL=file:./test.db npx prisma db push
# See also .env.test for the documented test value.
