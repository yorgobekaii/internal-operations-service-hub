# Isolated E2E test database. E2E tests use prisma/test.db and NEVER touch prisma/dev.db.
# The e2e harness sets DATABASE_URL=file:./test.db programmatically (see test/test-database.ts
# and test/setup-e2e.ts); this file documents the intended value for manual runs:
#   DATABASE_URL=file:./test.db npx prisma db push
#   DATABASE_URL=file:./test.db npx jest --config ./test/jest-e2e.json
DATABASE_URL="file:./test.db"
