generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model ServiceRequest {
  id            String    @id @default(uuid())
  title         String
  category      String
  status        String    @default("Submitted")
  priority      String    @default("Standard")
  description   String?
  requesterId   String?
  queueId       String?
  ownerId       String?
  backupOwnerId String?
  blockedReason String?
  slaDueAt      DateTime?
  payloadJson   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([queueId, status])
  @@index([requesterId, createdAt])
  @@index([status, priority, createdAt])
}

model User {
  id         String   @id @default(uuid())
  name       String   @default("")
  email      String   @unique
  role       String   @default("requester")
  department String?
  active     Boolean  @default(true)
  departmentId String?
  departmentRef Department? @relation(fields: [departmentId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([departmentId, role, active])
}

model Queue {
  id            String   @id @default(uuid())
  name          String   @unique
  category      String   @unique
  ownerId       String?
  backupOwnerId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Department {
  id        String   @id @default(uuid())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]
  mappings  DepartmentCategoryMapping[]
}

model DepartmentCategoryMapping {
  id           String     @id @default(uuid())
  category     String     @unique
  departmentId String
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  department   Department @relation(fields: [departmentId], references: [id])

  @@index([departmentId, active])
}

model SystemSettings {
  id                          String   @id @default("default")
  autoApprovalThresholdCents Int      @default(100000)
  urgentSlaHours             Int      @default(2)
  highSlaHours               Int      @default(24)
  standardSlaHours           Int      @default(72)
  lowSlaHours                Int      @default(120)
  updatedBy                  String?
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
}

model AdminAuditEntry {
  id         String   @id @default(uuid())
  actorId    String
  entityType String
  entityId   String
  action     String
  beforeJson String?
  afterJson  String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
}

model ApprovalStep {
  id         String    @id @default(uuid())
  requestId  String
  approverId String?
  status     String    @default("pending")
  rationale  String?
  decidedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([requestId])
  @@index([approverId, status])
}

model AuditEntry {
  id        String   @id @default(uuid())
  requestId String
  actorId   String
  from      String?
  to        String?
  action    String   @default("status_changed")
  createdAt DateTime @default(now())

  @@index([requestId, createdAt])
}

model Comment {
  id        String   @id @default(uuid())
  requestId String
  authorId  String
  body      String
  createdAt DateTime @default(now())

  @@index([requestId, createdAt])
}
